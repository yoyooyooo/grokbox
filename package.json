{
  "name": "grokbox",
  "version": "0.1.0-alpha.6",
  "packageManager": "bun@1.3.14",
  "description": "Unofficial CLI and control plane for Grok Bot cloud computers",
  "license": "MIT",
  "author": "grokbox contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoyooyooo/grokbox.git"
  },
  "homepage": "https://github.com/yoyooyooo/grokbox#readme",
  "bugs": {
    "url": "https://github.com/yoyooyooo/grokbox/issues"
  },
  "type": "module",
  "workspaces": {
    "packages": ["packages/*", "apps/*"],
    "catalogs": {
      "effect-v4-beta": {
        "effect": "4.0.0-beta.107"
      },
      "ai-sdk": {
        "ai": "5.0.253",
        "@ai-sdk/openai": "2.0.125"
      }
    }
  },
  "bin": {
    "grokbox": "bin/grokbox",
    "gbox": "bin/grokbox"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "keywords": [
    "grokbox",
    "grok-bot",
    "cli",
    "agents",
    "cloud-computer",
    "automation"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "node scripts/build-web.mjs",
    "web:serve": "node dist/web/run.mjs",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "test:web": "bun test apps/web/test/operations.test.ts test/job-management.test.ts test/desktop-management.test.ts test/web-bridge.test.ts test/observation-management.test.ts test/incident-actions.test.ts test/notification-management.test.ts test/notification-setup.test.ts test/materials-management.test.ts test/file-management.test.ts test/protection-management.test.ts test/lifecycle-management.test.ts test/context-management.test.ts ./test/compaction-management.test.ts ./test/handover-management.test.ts test/host-health-management.test.ts test/web-browser.test.ts",
    "verify:web-browser": "bun test test/web-browser.test.ts",
    "verify:host-health": "node scripts/verify-host-health.mjs core && node scripts/verify-host-health.mjs integration",
    "qualify:host-health": "bun scripts/qualify-host-health.ts",
    "modeld:run": "node scripts/run-packaged-modeld.mjs --json",
    "grokbox": "bun run packages/cli/src/index.ts",
    "gbox": "bun run packages/cli/src/index.ts",
    "shim:install": "bun run scripts/install-local-shim.mjs",
    "shim:verify": "bun test test/local-shim.test.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "test:native-host": "GROKBOX_TEST_NATIVE_HOST=1 node scripts/verify-host-health.mjs native-host",
    "check:docs": "bun test test/docs-governance.test.ts test/live-e2e-checklist.test.ts test/live-validation-harness.test.ts",
    "check:publication": "node scripts/check-publication.mjs",
    "check:publication:history": "node scripts/check-publication.mjs --history --ref HEAD",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "bun test test/packaging.test.ts",
    "verify:modeld-core": "bun scripts/verify-modeld-core.mjs",
    "benchmark:modeld-core": "bun scripts/benchmark-modeld-core.mjs",
    "check": "bun run typecheck && bun test && bun run verify:package",
    "release:check": "bun run check",
    "release:precheck": "bun run scripts/release.ts --precheck",
    "release": "bun run scripts/release.ts",
    "verify:context-continuity": "bun scripts/verify-context-continuity.mjs",
    "verify:external": "node scripts/verify-external.mjs",
    "verify:live-window": "node scripts/live-validation.mjs",
    "observe:sandbox": "node scripts/observe-sandbox.mjs",
    "experiment:sandbox-ssh-activity": "node scripts/experiment-sandbox-ssh-activity.mjs",
    "monitor:sandbox-ssh-activity": "node scripts/monitor-sandbox-ssh-activity.mjs",
    "publish:template": "bun run scripts/publish-grokbox-template.ts"
  },
  "dependencies": { "classic-level": "3.0.0", "sqlite3": "6.0.1" },
  "trustedDependencies": ["sqlite3"],
  "devDependencies": {
    "commander": "^14.0.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
